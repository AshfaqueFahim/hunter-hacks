# LLM key for the complaint-drafting endpoint. OpenAI is preferred if both are set.
# OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override the SQLite database location (optional; defaults to ./data/app.db)
# APP_DB_PATH=

# Cookieless Umami analytics (optional — analytics are disabled when unset).
# Only borough, verdict result and language are ever sent; see src/lib/analytics.ts.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
