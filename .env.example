# LLM key for the complaint-drafting endpoint. OpenAI is preferred if both are set.
# OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Override the SQLite database location (optional; defaults to ./data/app.db)
# APP_DB_PATH=

# Cookieless Umami analytics (optional — analytics are disabled when unset).
# Only borough, verdict result and language are ever sent; see src/lib/analytics.ts.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Upstash Redis (free tier) — install from the Vercel Marketplace, which sets
# these for you. Backs the per-IP draft rate limit, the daily AI cap and the
# opt-in feedback contact list. Without it, limits are per-instance only and
# feedback emails are refused.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Max AI drafting calls per New York calendar day, across all users (default 200).
# AI_DAILY_CAP=200
